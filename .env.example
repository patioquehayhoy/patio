# Copia a .env.local para desarrollo; configura los mismos nombres en EAS.
# Los valores aquí son intencionalmente vacíos. Nunca guardes credenciales reales.

# Opcional: staging o proyecto nuevo. Configura ambas juntas.
# Solo la publishable key del cliente; jamás service_role ni llaves IA.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Maps SDK for Android: restringir por com.parcomx.patio + SHA-1 de firma.
# La llave viaja en el binario; NO es una credencial de servidor.
GOOGLE_MAPS_ANDROID_API_KEY=

# Ruta local a google-services.json (configuración cliente de Firebase Android).
# En EAS usar variable de tipo archivo: GOOGLE_SERVICES_JSON.
# FCM V1 service-account JSON se carga en EAS Credentials, nunca en esta variable.
GOOGLE_SERVICES_JSON=
