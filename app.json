{
  "expo": {
    "name": "Patio",
    "slug": "lafondita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/p-icon-transparent.png",
    "scheme": "patio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.parcomx.patio",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Toma foto del menú para subirlo automáticamente",
        "NSPhotoLibraryUsageDescription": "Elige una foto del menú desde tu galería",
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para colocar tu negocio en el mapa de Patio"
      }
    },
    "android": {
      "package": "com.parcomx.patio",
      "adaptiveIcon": {
        "backgroundColor": "#EFEFEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Elige una foto del menú desde tu galería",
          "cameraPermission": "Toma foto del menú para subirlo automáticamente"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Toma foto del menú para subirlo automáticamente"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/p-icon-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F3F0",
          "dark": {
            "image": "./assets/images/p-icon-transparent-blanco.png",
            "imageWidth": 200,
            "backgroundColor": "#111214"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para mostrarte en el mapa de Patio"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2594b27c-9b35-4a52-8fc0-6367d3bfa59f"
      }
    },
    "owner": "parcomx"
  }
}
