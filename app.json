{
  "expo": {
    "name": "Patio",
    "slug": "lafondita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/p-icon.png",
    "scheme": "patio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.parcomx.patio",
      "privacyManifests": {
        "NSPrivacyTracking": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "es_MX",
        "CFBundleLocalizations": [
          "es",
          "es_MX"
        ],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Para tomar fotos de tu menú, de tu lugar o para tus reseñas",
        "NSPhotoLibraryUsageDescription": "Para elegir fotos de tu menú, de tu lugar o para tus reseñas",
        "NSLocationWhenInUseUsageDescription": "Usamos tu ubicación para encontrar comida cercana y ubicar tu negocio en el mapa de Patio"
      }
    },
    "android": {
      "package": "com.parcomx.patio",
      "adaptiveIcon": {
        "backgroundColor": "#EFEFEF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para elegir fotos de tu menú, de tu lugar o para tus reseñas",
          "cameraPermission": "Para tomar fotos de tu menú, de tu lugar o para tus reseñas",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Para tomar fotos de tu menú, de tu lugar o para tus reseñas",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/p-icon-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F3F3F0",
          "dark": {
            "image": "./assets/images/p-icon-transparent-blanco.png",
            "imageWidth": 200,
            "backgroundColor": "#111214"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos tu ubicación para encontrar comida cercana y ubicar tu negocio en el mapa de Patio",
          "locationAlwaysPermission": "Si activas «Tus visitas», Patio nota cuando visitas un lugar para preguntarte qué te pareció y cuenta la visita, sin tu nombre, para mostrar qué tan lleno está.",
          "locationAlwaysAndWhenInUsePermission": "Si activas «Tus visitas», Patio nota cuando visitas un lugar para preguntarte qué te pareció y cuenta la visita, sin tu nombre, para mostrar qué tan lleno está.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-iap"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2594b27c-9b35-4a52-8fc0-6367d3bfa59f"
      }
    },
    "owner": "patio-quehayhoy"
  }
}
