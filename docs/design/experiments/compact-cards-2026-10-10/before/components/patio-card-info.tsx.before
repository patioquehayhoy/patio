import { Ionicons } from '@expo/vector-icons';
import { StyleSheet, Text, View, useWindowDimensions, type StyleProp, type ViewStyle } from 'react-native';

import { getPatioCardInfo, patioCardPrice } from '@/lib/patio-card-info';
import type { Patio } from '@/lib/patios';
import { useTheme, type Theme } from '@/lib/theme';
import { noWidow } from '@/lib/typography';

export type PatioCardInfoProps = {
  patio: Patio;
  variant?: 'list' | 'grid';
  distanceLabel?: string | null;
  personalRating?: number | null;
  /** Include the personal rating alongside the other compact metrics. */
  showPersonalRating?: boolean;
  /** Grid cards place the same price in their leading icon row. */
  showPrice?: boolean;
  style?: StyleProp<ViewStyle>;
};

/** Shared content only: the parent owns navigation, selection and materials. */
export function PatioCardInfo({
  patio, variant = 'list', distanceLabel, personalRating, showPersonalRating = false, showPrice = true, style,
}: PatioCardInfoProps) {
  const { theme } = useTheme();
  const s = makeStyles(theme);
  const { fontScale, width } = useWindowDimensions();
  const grid = variant === 'grid';
  const stackPrice = fontScale > 1.4 && width < 600;
  const info = getPatioCardInfo(patio, { distanceLabel, personalRating });

  return (
    <View style={[s.content, style]}>
      <View style={[s.heading, stackPrice && s.stackedHeading]}>
        <View style={[s.identity, stackPrice && s.stackedIdentity, grid && { minHeight: 42 * fontScale }]}>
          <Text style={s.name} numberOfLines={2} ellipsizeMode="tail" accessibilityLabel={info.name} allowFontScaling>{noWidow(info.name)}</Text>
          <View style={[s.verification, { height: 21 * fontScale }]}>
            {info.verified && <Ionicons name="checkmark-circle" size={14} color={theme.accent} accessibilityLabel="Negocio verificado" />}
          </View>
        </View>
        {showPrice && <PatioCardPrice patio={patio} style={stackPrice ? s.stackedPrice : [s.trailingPrice, { width: 92 * fontScale }]} />}
      </View>
      {(grid || info.area || distanceLabel?.trim()) && <View style={[s.location, grid && { minHeight: 18 * fontScale }]}>
        {!!info.area && <Text style={s.area} numberOfLines={1} ellipsizeMode="tail" accessibilityLabel={info.area} allowFontScaling>{noWidow(info.area)}</Text>}
        {distanceLabel?.trim() && <View style={s.cell} accessible accessibilityLabel={info.distanceAccessibilityLabel}>
          <View style={s.icon}><Ionicons name="navigate-outline" size={12} color={theme.textSecondary} /></View>
          <Text style={[s.meta, s.numeric]} allowFontScaling>{info.distance}</Text>
        </View>}
      </View>}
      <View style={[s.facts, grid && { minHeight: 18 * fontScale }]}>
        <View style={s.publicRating} accessible accessibilityLabel={info.publicRatingAccessibilityLabel}>
          <View style={s.icon}><Ionicons name="star" size={12} color={theme.textSecondary} /></View>
          <Text style={[s.meta, s.numeric]} numberOfLines={1} allowFontScaling>{info.publicRating}</Text>
        </View>
        {showPersonalRating && <View style={[s.ownRating, { width: 44 * fontScale }]} accessible accessibilityLabel={info.personalRatingAccessibilityLabel}>
          <View style={s.icon}><Ionicons name={info.personalRatingValue === null ? 'star-outline' : 'star'} size={12} color={info.personalRatingValue === null ? theme.textMute : theme.accent} /></View>
          {info.personalRatingValue !== null && <Text style={[s.meta, s.numeric, s.ownRatingNumber]} numberOfLines={1} allowFontScaling>{info.personalRatingValue.toFixed(1)}</Text>}
        </View>}
      </View>
    </View>
  );
}

/** Published price is a comparison anchor; never truncate or shrink the amount. */
export function PatioCardPrice({ patio, style }: { patio: Patio; style?: StyleProp<ViewStyle> }) {
  const { theme } = useTheme();
  const s = makeStyles(theme);
  const price = patioCardPrice(patio);
  return <View style={[s.priceSlot, style]}>
    <Text style={[s.price, price.source === 'missing' && s.missingPrice]} allowFontScaling accessibilityLabel={price.accessibilityLabel}>
      {noWidow(price.label)}
    </Text>
  </View>;
}

function makeStyles(t: Theme) {
  return StyleSheet.create({
    content: { flex: 1, minWidth: 0 },
    heading: { flexDirection: 'row', alignItems: 'flex-start', gap: 8 },
    stackedHeading: { flexDirection: 'column', gap: 3 },
    stackedIdentity: { flex: 0, width: '100%' },
    identity: { flex: 1, minWidth: 0, flexDirection: 'row', alignItems: 'flex-start', gap: 4 },
    name: { flex: 1, minWidth: 0, fontSize: 16, lineHeight: 21, fontWeight: '700', color: t.text },
    verification: { width: 16, height: 21, flexShrink: 0, alignItems: 'center', justifyContent: 'center' },
    area: { flexShrink: 1, minWidth: 0, fontSize: 13, lineHeight: 18, fontWeight: '400', color: t.textSecondary },
    location: { flexDirection: 'row', flexWrap: 'wrap', alignItems: 'center', columnGap: 8, rowGap: 2, marginTop: 2, minWidth: 0 },
    facts: { flexDirection: 'row', alignItems: 'center', gap: 8, marginTop: 2, minWidth: 0 },
    publicRating: { flex: 1, minWidth: 0, flexDirection: 'row', alignItems: 'center', gap: 4 },
    ownRating: { flexShrink: 0, flexDirection: 'row', alignItems: 'center', gap: 4 },
    ownRatingNumber: { flex: 1, minWidth: 0, textAlign: 'right' },
    cell: { flexShrink: 1, maxWidth: '100%', minWidth: 0, flexDirection: 'row', alignItems: 'center', gap: 4 },
    icon: { width: 16, height: 18, flexShrink: 0, alignItems: 'center', justifyContent: 'center' },
    meta: { flexShrink: 1, fontSize: 12, lineHeight: 18, fontWeight: '400', color: t.textSecondary },
    numeric: { fontVariant: ['tabular-nums'] },
    priceSlot: { minWidth: 0, alignItems: 'flex-end' },
    trailingPrice: { flexShrink: 0 },
    stackedPrice: { alignSelf: 'flex-end', maxWidth: '100%' },
    price: { fontSize: 14, lineHeight: 20, fontWeight: '700', textAlign: 'right', color: t.text, fontVariant: ['tabular-nums'] },
    missingPrice: { fontSize: 12, fontWeight: '400', color: t.textSecondary },
  });
}
